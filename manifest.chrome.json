{
  "manifest_version": 3,
  "name": "AutoFill",
  "version": "1.0.0",
  "description": "Automatically fill form fields (text, checkbox, radio, select) on page load for URLs you configure.",
  "author": "AutoFill Extension",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/browser-polyfill.js", "content/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "AutoFill"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
